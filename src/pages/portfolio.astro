<!-- MODAL -->

<div class="video-modal">

    <div class="video-modal-content">

        <button class="close-video">

            ✕

        </button>

        <video id="portfolioPlayer" controls>

            <source id="portfolioSource">

        </video>

    </div>

</div>

<script>

const modal=document.querySelector(".video-modal");

const player=document.getElementById("portfolioPlayer");

const source=document.getElementById("portfolioSource");

document.querySelectorAll(".play-button").forEach(btn=>{

    btn.addEventListener("click",()=>{

        source.src=btn.dataset.video;

        player.load();

        modal.classList.add("show");

        player.play();

    });

});

document.querySelector(".close-video").addEventListener("click",()=>{

    player.pause();

    modal.classList.remove("show");

});

modal.addEventListener("click",(e)=>{

    if(e.target===modal){

        player.pause();

        modal.classList.remove("show");

    }

});

document.querySelectorAll(".portfolio-card").forEach(card=>{

    const preview=card.querySelector(".preview");

    card.addEventListener("mouseenter",()=>{

        preview.play();

    });

    card.addEventListener("mouseleave",()=>{

        preview.pause();

        preview.currentTime=0;

    });

});

</script>

