:root{
  --black:#111111;
  --dark:#1c1c1c;
  --gray:#666666;
  --light:#f6f6f6;
  --white:#ffffff;

  /* Color corporativo */
  --red:#e60012;

  --container:1200px;

  --transition:.30s ease;
}

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

html{
  scroll-behavior:smooth;
}

body{
  font-family: Arial, Helvetica, sans-serif;
  color:var(--black);
  background:var(--white);
  -webkit-font-smoothing:antialiased;
}

img{
  display:block;
  max-width:100%;
}

a{
  text-decoration:none;
  color:inherit;
}

.container{
  width:min(var(--container),92%);
  margin:auto;
}

section{
  padding:120px 0;
}

h1{
  font-size:clamp(3.5rem,7vw,6rem);
  line-height:1;
  font-weight:700;
}

h2{
  font-size:clamp(2.3rem,4vw,3.4rem);
  line-height:1.1;
}

p{
  color:var(--gray);
  line-height:1.8;
  font-size:1.1rem;
}

.section-tag{
  color:var(--red);
  text-transform:uppercase;
  letter-spacing:.18em;
  font-size:.82rem;
  font-weight:700;
  margin-bottom:20px;
}

.btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  padding:18px 34px;
  font-weight:700;
  transition:var(--transition);
}

.btn-primary{
  background:var(--red);
  color:white;
}

.btn-primary:hover{
  background:black;
}

.btn-secondary{
  border:2px solid white;
  color:white;
}

.btn-secondary:hover{
  background:white;
  color:black;
}