/* ===================================================
   FEATURED PROJECTS
=================================================== */

.projects{
  background:#fff;
}

.projects h2{
  max-width:700px;
  margin-bottom:70px;
}

.project-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:40px;
}

.project-card{
  transition:.35s ease;
  cursor:pointer;
}

.project-card:hover{
  transform:translateY(-8px);
}

.project-card img{
  width:100%;
  height:340px;
  object-fit:cover;
}

.project-info{
  padding:24px 0;
}

.project-info span{
  color:var(--red);
  text-transform:uppercase;
  font-size:.8rem;
  font-weight:700;
  letter-spacing:.15em;
}

.project-info h3{
  margin:14px 0;
  font-size:1.5rem;
}

.project-info p{
  max-width:90%;
}


/* ===================================================
   ABOUT
=================================================== */

.about{
  background:var(--light);
}

.about-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:90px;
  align-items:center;
}

.about-image img{
  width:100%;
  border-radius:6px;
}

.about-content h2{
  margin:20px 0 35px;
}

.about-content p{
  margin-bottom:22px;
}


/* ===================================================
   CLIENTES
=================================================== */

.clients{
  background:white;
  text-align:center;
}

.clients h2{
  margin-bottom:60px;
}

.logos{
  display:grid;
  grid-template-columns:repeat(5,1fr);
  gap:60px;
  align-items:center;
}

.logos img{
  width:100%;
  max-width:150px;
  margin:auto;
  filter:grayscale(100%);
  opacity:.65;
  transition:.3s;
}

.logos img:hover{
  opacity:1;
  filter:none;
  transform:scale(1.05);
}


/* ===================================================
   CTA
=================================================== */

.cta{
  background:#111;
  color:white;
  text-align:center;
}

.cta h2{
  color:white;
  margin-bottom:25px;
}

.cta p{
  color:#d7d7d7;
  max-width:650px;
  margin:0 auto 40px;
}


/* ===================================================
   RESPONSIVE
=================================================== */

@media(max-width:900px){

.nav{
    flex-direction:column;
    height:auto;
    padding:20px 0;
}

nav{
    margin-top:20px;
    gap:20px;
    flex-wrap:wrap;
    justify-content:center;
}

.project-grid{
    grid-template-columns:1fr;
}

.about-grid{
    grid-template-columns:1fr;
}

.logos{
    grid-template-columns:repeat(2,1fr);
}

.hero{
    height:auto;
    min-height:100vh;
    padding:140px 0 100px;
}

.hero-buttons{
    flex-direction:column;
    align-items:flex-start;
}

}listo

/* ===========================
FOOTER
=========================== */

footer{

padding:70px 0;

background:#111;

color:white;

}

.footer-content{

display:flex;

justify-content:space-between;

align-items:center;

gap:40px;

}

.footer-content h3{

margin-bottom:12px;

font-size:1.4rem;

}

.footer-content p{

color:#bdbdbd;

}

.footer-links{

display:flex;

gap:30px;

flex-wrap:wrap;

}

.footer-links a{

color:white;

transition:.25s;

}

.footer-links a:hover{

color:var(--red);

}

@media(max-width:900px){

.footer-content{

flex-direction:column;

align-items:flex-start;

}

.footer-links{

flex-direction:column;

gap:15px;

}

}
